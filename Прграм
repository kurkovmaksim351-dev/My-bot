USER_FILE = "users.json"
ORDER_FILE = "orders.json"
AD_FILE = "ads.json"

def load_users():
    if os.path.exists(USER_FILE):
        with open(USER_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def save_users(users):
    with open(USER_FILE, "w", encoding="utf-8") as f:
        json.dump(users, f, indent=2, ensure_ascii=False)

def load_orders():
    if os.path.exists(ORDER_FILE):
        with open(ORDER_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def save_orders(orders):
    with open(ORDER_FILE, "w", encoding="utf-8") as f:
        json.dump(orders, f, indent=2, ensure_ascii=False)

def load_ads():
    if os.path.exists(AD_FILE):
        with open(AD_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {}

def save_ads(ads):
    with open(AD_FILE, "w", encoding="utf-8") as f:
        json.dump(ads, f, indent=2, ensure_ascii=False)

users = load_users()
orders = load_orders()
ads = load_ads()

def clean_expired_ads():
    while True:
        time.sleep(3600)
        ads = load_ads()
        now = time.time()
        to_delete = [aid for aid, data in ads.items() if data["expires_at"] < now]
        for aid in to_delete:
            del ads[aid]
        save_ads(ads)

threading.Thread(target=clean_expired_ads, daemon=True).start()

