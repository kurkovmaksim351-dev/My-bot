@bot.message_handler(commands=['confirm'])
def confirm_withdraw(message):
    if str(message.chat.id) != str(ADMIN_ID):
        bot.send_message(message.chat.id, "❌ Только для админа.")
        return
    try:
        request_id = message.text.split()[1]
    except:
        bot.send_message(message.chat.id, "❌ Используй: /confirm 1700000000")
        return
    found = False
    for uid, data in users.items():
        for req in data.get("withdraw_requests", []):
            if req["id"] == request_id and req["status"] == "pending":
                req["status"] = "completed"
                data["balance_rub"] = 0
                save_users(users)
                bot.send_message(
                    message.chat.id,
                    f"✅ Заявка {request_id} подтверждена. Баланс обнулён."
                )
                bot.send_message(
                    uid,
                    f"✅ Ваша заявка на вывод {req['amount']} руб. подтверждена! Деньги отправлены."
                )
                found = True
                break
        if found:
            break
    if not found:
        bot.send_message(message.chat.id, "❌ Заявка не найдена.")

@bot.message_handler(func=lambda m: True)
def handle_all(message):
    user_id = str(message.chat.id)
    text = message.text.strip()

    if user_id not in users:
        users[user_id] = {"balance_rub": 0, "stars": 0}
        save_users(users)

    if users[user_id].get("awaiting_link"):
        if text.startswith("http"):
            order_id = str(int(time.time()))
            orders[order_id] = {
                "id": order_id,
                "link": text,
                "customer": user_id,
                "status": "waiting"
            }
            save_orders(orders)
            users[user_id]["awaiting_link"] = False
            save_users(users)
            bot.send_message(message.chat.id, f"✅ Задание сохранено!\n🔗 {text}")
        else:
            bot.send_message(message.chat.id, "❌ Отправь ссылку (https://...)")
        return

    if users[user_id].get("awaiting_review") and text.startswith("http"):
        task_id = users[user_id].get("current_task")
        if task_id and task_id in orders:
            boost = users[user_id].get("boost", {})
            multiplier = 1
            if boost.get("active") and boost.get("expires_at", 0) > time.time():
                multiplier = boost.get("multiplier", 1)
            reward = 10 * multiplier
            users[user_id]["balance_rub"] += reward
            users[user_id]["completed_tasks"] = users[user_id].get("completed_tasks", 0) + 1
            users[user_id]["awaiting_review"] = False
            users[user_id]["current_task"] = None
            orders[task_id]["status"] = "completed"
            save_users(users)
            save_orders(orders)
            bot.send_message(
                message.chat.id,
                f"✅ Отзыв принят! +{reward} руб.\n💰 Баланс: {users[user_id]['balance_rub']} руб."
            )
        else:
            bot.send_message(message.chat.id, "❌ У тебя нет активного задания.")
        return

    if users[user_id].get("awaiting_phone"):
        phone = text.replace(" ", "").replace("-", "").replace("+", "")
        if phone.isdigit() and len(phone) == 11:
            users[user_id]["phone"] = phone
            users[user_id]["awaiting_phone"] = False
            now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            request_id = str(int(time.time()))
            balance = users[user_id]["balance_rub"]
            withdraw_data = {
                "id": request_id,
                "user_id": user_id,
                "phone": phone,
                "amount": balance,
                "date": now,
                "status": "pending"
            }
            if "withdraw_requests" not in users[user_id]:
                users[user_id]["withdraw_requests"] = []
            users[user_id]["withdraw_requests"].append(withdraw_data)
            save_users(users)

            bot.send_message(
                message.chat.id,
                f"✅ Заявка на вывод принята!\n\n"
                f"💰 Сумма: {balance} руб.\n"
                f"📱 Телефон: {phone}\n"
                f"📅 Дата: {now}\n"
                f"🆔 Заявка: {request_id}\n\n"
                f"⏳ Ожидай подтверждения."
            )

            bot.send_message(
                ADMIN_ID,
                f"🔔 НОВАЯ ЗАЯВКА НА ВЫВОД\n\n"
                f"🆔 {request_id}\n"
                f"👤 {user_id}\n"
                f"📱 {phone}\n"
                f"💰 {balance} руб.\n"
                f"📅 {now}"
            )
        else:
            bot.send_message(message.chat.id, "❌ Введи 11 цифр (например, 79001234567)")
        return

    if users[user_id].get("awaiting_channel_link"):
        if text.startswith("https://t.me/"):
            ads = load_ads()
            ad_id = str(int(time.time()))
            ads[ad_id] = {
                "link": text,
                "owner": user_id,
                "created_at": time.time(),
                "expires_at": time.time() + 31 * 24 * 3600
            }
            save_ads(ads)
            users[user_id]["awaiting_channel_link"] = False
            save_users(users)
            bot.send_message(message.chat.id, f"✅ Канал добавлен на 31 день!\n🔗 {text}")
        else:
            bot.send_message(message.chat.id, "❌ Отправь ссылку https://t.me/...")
        return

    if text == "🔙 Назад":
        main_menu(message)
        return

    bot.send_message(message.chat.id, "📌 Используй кнопки меню.")

