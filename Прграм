@bot.message_handler(commands=['boost'])
def buy_boost(message):
    user_id = str(message.chat.id)
    try:
        days = int(message.text.split()[1])
    except:
        bot.send_message(message.chat.id, "❌ Используй: /boost 7  или  /boost 31")
        return
    if days == 7:
        price = 1
    elif days == 31:
        price = 3
    else:
        bot.send_message(message.chat.id, "❌ Только 7 или 31 день.")
        return
    if users[user_id].get("stars", 0) < price:
        bot.send_message(message.chat.id, f"❌ Нужно {price} звезд.")
        return
    users[user_id]["stars"] -= price
    users[user_id]["boost"] = {
        "active": True,
        "expires_at": time.time() + days * 24 * 3600,
        "multiplier": 2
    }
    save_users(users)
    bot.send_message(message.chat.id, f"✅ Удвоитель активирован на {days} дней!")

